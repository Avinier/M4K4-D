835d5cf-ed4b-5509-9c15-6d7f02135274")) (no_connect (at 231.14 129.54) (uuid "52cbec64-75c8-5412-b509-2b12efb08b25")) (no_connect (at 231.14 137.16) (uuid "8a1f142e-40fc-58e1-b609-8af6265dc313")) (no_connect (at 231.14 175.26) (uuid "27fcc7df-be9b-51e5-b972-ae4078c1d6f9")) (no_connect (at 231.14 182.88) (uuid "b9c2c93d-f30d-5cc0-b735-d7c2d4e04885")) (no_connect (at 231.14 185.42) (uuid "37fb793b-e2b1-57e1-9948-a0405b634f08")) (no_connect (at 231.14 187.96) (uuid "0704e003-f940-554e-9b5a-e97d3bcbb8c4")) (no_connect (at 274.32 58.42) (uuid "27c58476-91b4-5f39-b026-fb2e318990ca")) (no_connect (at 274.32 193.04) (uuid "cbb4ae0c-ba01-53a4-b2b4-d5b4b690647e")) (text "U1: genuine Espressif ESP32-S3-DevKitC-1-N8 v1.1 (D-068), soldered on through its own headers. GPIO map v0.2 (PCB-10 README)." (exclude_from_sim no) (at 416.56 20.32 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "120d9167-acfd-5dfc-9ae4-8b59fbec0b49")) (text "GPIO map v0.3 (layout): pins chosen so each track runs to its connector without crossings. Unused: GPIO0/3/45/46 (strapping), 19/20/43/44 (USB), 35/39/40 (spares), 38 (v1.1 RGB LED)." (exclude_from_sim no) (at 416.56 24.765 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0b4b8a73-0a5a-5a96-844b-a8d5048c6eb6")) (text "J10-1: PB-SAFE-BASE 5 V (05-harness 5.1). D1 Schottky to the DevKitC 5V pin: a service USB cable can't back-feed W11 (D-068 E)." (exclude_from_sim no) (at 416.56 29.21 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5fb96b59-915d-56e2-bf63-936c64950be0")) (text "+3V3 is the DevKitC's own SGM2212-3.3 (800 mA); the carrier draws about 65 mA peak from it (lesson 1)." (exclude_from_sim no) (at 416.56 33.655 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fd034580-1f69-57ba-af26-45fbc86a300e")) (text "U3 TPS3436CCCBG (D-068 C): feed falling edge on WDI every 10 ms; valid window 5.5-18 ms, late fault <= 22 ms;" (exclude_from_sim no) (at 416.56 38.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "69915924-fb46-557b-b54c-d91d1446414a")) (text "first edge within 500 ms of power-up; WDO low 200 ms resets the DevKitC (EN) and drops READY. MR pulled up (no PG reaches C3)." (exclude_from_sim no) (at 416.56 42.545 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0599177a-ab5b-5ffd-97b7-c14447355a1e")) (text "READY = WDO AND WD-EN AND MCU_RDY (BD-10, BC-08). MCU_RDY (GPIO2) pulled down: unpowered or" (exclude_from_sim no) (at 416.56 46.99 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b5255d43-bd82-5ceb-929e-08cd6a8f7d40")) (text "resetting reads not ready. 1k out to J10-12 (PCB-03 BASE_READY, fail-inactive)." (exclude_from_sim no) (at 416.56 51.435 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fd742bb0-f525-592f-b552-367bbf155500")) (text "J10-5/6 (power-boards 2.4): SLP from U4 through 1k each; IN1/IN2 LEDC with 100R; FLT wired-OR, 10k pull-up, 1k to GPIO9." (exclude_from_sim no) (at 416.56 55.88 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "be134138-8ca6-56c9-9129-2f9a4f940f01")) (text "J10-2 (D-068 F, reordered at placement): 1 GND, 2/3 C0TX+/- (U2 A/B, 120R here), 4/5 C3TX-/+ (U2 Z/Y), 6 spare: U2's own pin order, so the pairs run straight. W25 1:1; PCB-09 J9-2 mirrors it." (exclude_from_sim no) (at 416.56 60.325 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fdf2f3d9-0370-595e-8aca-fda9bfb5531e")) (text "THVD1451: open/short/idle fail-safe, no bias needed. R18/R19 only with the MAX3490 alternate (open fail-safe only)." (exclude_from_sim no) (at 416.56 64.77000000000001 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d2d35456-ed19-578f-888c-a7a46a871939")) (text "Encoders: MOT3001 Hall encoder on 3.3 V (vendor 3.3-5 V). 100R series; pull-ups DNP until the output type is known." (exclude_from_sim no) (at 416.56 69.215 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1dd32d4e-f052-5bf2-b421-ee0043ca0090")) (text "Rear TCRT (D-016): LED 100R from 3V3, switched low side by Q1 (GPIO47, 100k pull-down: off at boot)." (exclude_from_sim no) (at 416.56 73.66 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "642fdc18-ccdf-5ced-b520-5e00fb0ec542")) (text "TCRT_OUT 10k pull-up: unplugged or broken reads high = cliff = stop. 1k into GPIO8 (ADC1_CH7)." (exclude_from_sim no) (at 416.56 78.105 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "496e86f1-3f05-53ea-b4f4-74da647b18ba")) (text "GP2Y_VO 10k/22k: 2.70 V max at 10 cm -> 1.86 V; a 5 V fault -> 3.44 V, under the S3's 3.6 V. 100n: the output updates every ~38 ms." (exclude_from_sim no) (at 416.56 82.55000000000001 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8782bbfc-d487-5571-b2f6-720393a24a60")) (text "HALL_OUT: 1M to GND reads an open wire as 0 V (fault); 1k + 1n into GPIO10 (ADC1_CH9). PCB-15 has its own 1k/100n." (exclude_from_sim no) (at 416.56 86.995 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d7408356-84f4-54dc-a40d-1a3a9b1c2a8d")) (text "H1/H2: the two lower M2.5 screws (Z 86). The top edge sits in two printed hooks (D-068 A)." (exclude_from_sim no) (at 416.56 91.44 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d3068759-995e-5d2f-addd-804829a67220")) (sheet_instances (path "/" (page "1"))))
